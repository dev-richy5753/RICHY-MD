# Telegram bot token from @BotFather (required for `npm start`)
BOT_TOKEN=

# Your numeric Telegram user ID (required; the bot owner)
OWNER_TELEGRAM_ID=

# Telegram username without @ (optional for bot links)
TELEGRAM_BOT_USERNAME=

# Admin panel password (keep private)
ADMIN_PASSWORD=

# Optional explicit signing secret for persistent browser sessions
# APP_SESSION_SECRET=

# Optional path on persistent disk for WhatsApp credentials and panel data.
# Example VPS path: SESSION_DIR=/var/lib/richy-md/session
# Keep this directory private and backed up; never commit it to Git.
# SESSION_DIR=

# Optional public link to this Telegram bot (for the website CTA)
# TELEGRAM_BOT_URL=https://t.me/Phicodm_bot

# Optional defaults
BOT_NAME=RICHY MD
DEV_NAME=Ezihe
PREFIX=.
# Bundled menu photos are selected randomly; the menu soundtrack follows each menu.
# Set MENU_IMAGES to override with photo URLs, separated by |.
# CHANNEL_URL=
# GROUP_URL=

# Optional for the standalone WhatsApp process (`npm run dev`)
# PAIRING_NUMBER=
# Override the default WhatsApp pairing code (RICHYDEV):
# CUSTOM_PAIRING_CODE=YOURCODE
